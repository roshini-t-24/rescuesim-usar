# Copy to .env. Both keys are optional: with no keys every agent uses its deterministic offline fallback.
NEBIUS_API_KEY=
TAVILY_API_KEY=

# Model IDs (verify with GET /api/models)
NEBIUS_PLANNER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_REFLEX_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Physics calibration (defaults shown)
RESCUESIM_COLLAPSE_RATE=0.002
RESCUESIM_SHELTER=0

# Set to 1 to force the offline planner even when NEBIUS_API_KEY is set (used for repeatable demos)
# RESCUESIM_NO_NEBIUS=1
