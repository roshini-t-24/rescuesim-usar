# Copy to .env. Both keys are optional: with no keys every agent uses its deterministic offline fallback.
NEBIUS_API_KEY=
TAVILY_API_KEY=

# Physics calibration (defaults shown)
RESCUESIM_COLLAPSE_RATE=0.002
RESCUESIM_SHELTER=0
